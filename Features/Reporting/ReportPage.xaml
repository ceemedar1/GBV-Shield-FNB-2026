<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GBV_Shield.Features.Reporting.ReportPage"
             Title="Report">

    <VerticalStackLayout Padding="20" Spacing="15">
        <Picker x:Name="TypePicker" Title="Select report type">
            <Picker.Items>
                <x:String>Harassment</x:String>
                <x:String>Violence</x:String>
                <x:String>Threat</x:String>
                <x:String>Other</x:String>
            </Picker.Items>
        </Picker>

        <Editor x:Name="ReportEditor"
        Placeholder="Describe your report here..."
        AutoSize="TextChanges"
        HeightRequest="120" />


        <Editor HeightRequest="120" />

        <Button Text="Submit Report" Clicked="OnSubmitReportClicked" />
    </VerticalStackLayout>
</ContentPage>
